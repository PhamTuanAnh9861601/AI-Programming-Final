# Copy to .env and insert your own key. Never commit .env.
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b

# Optional: set current provider rates (USD per 1M tokens) to estimate evaluation cost.
# GROQ_INPUT_USD_PER_MILLION=
# GROQ_OUTPUT_USD_PER_MILLION=

# RAG (tùy chọn)
